<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:C971_Grant_Putnam.Models"
             x:Class="C971_Grant_Putnam.MainPage">

    <Grid RowDefinitions="10*,80*,10*">

        <Grid Grid.Row="0" RowDefinitions="Auto,*">
            <Label HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Grid.Row="0">WGU</Label>
            <CollectionView Background="Blue" HorizontalOptions="Fill"
                            Grid.Row="1"
                            Margin="0"
                            ItemsLayout="HorizontalList"
                            ItemsSource="{Binding Terms}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Term">
                        <Button Padding="20,10,20,10" Margin="10,0,0,0" Text="{Binding Name}" Background="Gray" VerticalOptions="Center"></Button>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            
            </CollectionView>
        </Grid>

        <Grid Grid.Row="1">
            
        </Grid>
        
    </Grid>

</ContentPage>
