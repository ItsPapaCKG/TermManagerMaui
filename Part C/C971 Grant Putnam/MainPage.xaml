<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C971_Grant_Putnam.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <HorizontalStackLayout>
                <Label FontSize="25" Margin="25">Item 1</Label>
                <Label FontSize="25" Margin="25">Item 1</Label>
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding termNames}" HorizontalOptions="Center"></CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
