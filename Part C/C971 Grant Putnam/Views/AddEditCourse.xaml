<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C971_Grant_Putnam.Views.AddEditCourse"
             Title="AddEditCourse">
    <Grid RowDefinitions="Auto,Auto,40*">
        <Grid Grid.Row="0" ColumnDefinitions="60*,40*" BackgroundColor="DarkSlateGrey" Padding="30">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="0">
                <Entry TextColor="White" FontAttributes="Bold" Text="{Binding CourseEdit.Name}"></Entry>
                <DatePicker TextColor="White" Date="{Binding CourseEdit.Start}"></DatePicker>
                <DatePicker TextColor="White" Date="{Binding CourseEdit.End}"></DatePicker>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <ImageButton Source="check_mark.png" WidthRequest="50" HeightRequest="50" Grid.Column="1" VerticalOptions="Center" BackgroundColor="LawnGreen" BorderColor="Black" BorderWidth="2" CommandParameter="{Binding CourseEdit}" Command="{Binding SaveChangesToCourseCommand}"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <VerticalStackLayout Padding="30" Grid.Row="1">
                <Label FontAttributes="Bold,Italic" FontSize="20">Course Instructor Information</Label>
                <Entry FontSize="17" Margin="20,0,0,0" Placeholder="Instructor Name" Text="{Binding CourseEdit.Instructor_Name}"></Entry>
                <Entry FontSize="17" Margin="20,0,0,0" Placeholder="Instructor Phone" Text="{Binding CourseEdit.Instructor_Phone}"></Entry>
                <Entry FontSize="17" Margin="20,0,0,0" Placeholder="Instructor Email" Text="{Binding CourseEdit.Instructor_Email}"></Entry>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="2">
            <Frame CornerRadius="10" Margin="30,0,30,30" Padding="15">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Label Grid.Row="0" Margin="0,0,0,15" FontAttributes="Bold" FontSize="20">Course Notes</Label>

                    <Frame Grid.Row="1">
                        <Editor Text="{Binding CourseEdit.Notes}"/>
                    </Frame>

                    <Button Text="Share Notes" Grid.Row="2" Margin="0,10,0,0"></Button>
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>